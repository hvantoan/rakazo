{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": { "eq": "www.aas.com" } }],
      "destination": "https://aas.com/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": { "eq": "www.aas.com" } }],
      "destination": "https://aas.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml",
      "statusCode": 301
    }
  ]
}
