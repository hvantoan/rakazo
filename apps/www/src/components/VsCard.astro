---
type Props = {
  otherName: string;
  aas: readonly string[];
  other: readonly string[];
};

const { otherName, aas, other } = Astro.props;
---

<figure class="vs-card">
  <div class="vs-card__grid">
    <div class="vs-card__col">
      <p class="vs-card__name">Agents Assistance</p>
      <ul>
        {aas.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <p class="vs-card__vs" aria-hidden="true">vs</p>
    <div class="vs-card__col">
      <p class="vs-card__name">{otherName}</p>
      <ul>
        {other.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
  <figcaption class="sr-only">Agents Assistance compared with {otherName}</figcaption>
</figure>
